{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node"],
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "jest.config.cjs"]
}
